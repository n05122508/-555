-- ===== ฟังก์ชันค้นหาข้อมูลรถและที่นั่ง =====
local function getValuesDrag()
	local interface = player.PlayerGui:FindFirstChild("Interface")
	return interface and interface:FindFirstChild("Values")
end

local function getValues()
	if isPoliceMap and aChassis then
		return aChassis:FindFirstChild("Values")
	else
		return getValuesDrag()
	end
end

local function FindNearestVehicle()
	local spawnedCars = workspace:FindFirstChild("SpawnedCars")
	if spawnedCars then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local nearestCar = nil
			local shortestDist = 40
			for _, carModel in pairs(spawnedCars:GetChildren()) do
				if carModel:IsA("Model") then
					local primary = carModel.PrimaryPart or carModel:FindFirstChildWhichIsA("BasePart")
					if primary then
						local dist = (hrp.Position - primary.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							nearestCar = carModel
						end
					end
				end
			end
			if nearestCar then return nearestCar end
		end
	end
	
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			return hum.SeatPart.Parent
		end
	end
	return nil
end

local function getVehicleSeat()
	local car = FindNearestVehicle()
	if car then
		local seat = car:FindFirstChild("DriveSeat") or car:FindFirstChildWhichIsA("VehicleSeat") or car:FindFirstChildWhichIsA("Seat")
		if seat then return seat end
	end
	
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then return hum.SeatPart end
	end
	return nil
end

-- ===== ฟังก์ชันปรับแต่งค่ารถ (Eng_PowerMult และ Eng_Dead) =====
local function ApplyCarModifications(carModel)
	if not carModel then return end
	pcall(function()
		local targetPower = tonumber(powerInput.Text)
		
		if carModel:GetAttribute("Eng_Dead") ~= nil then
			carModel:SetAttribute("Eng_Dead", false)
		end
		
		if targetPower then
			carModel:SetAttribute("Eng_PowerMult", targetPower)
		end

		for _, desc in pairs(carModel:GetDescendants()) do
			if desc:GetAttribute("Eng_Dead") ~= nil then
				desc:SetAttribute("Eng_Dead", false)
			end
			if desc.Name == "Eng_Dead" and desc:IsA("ValueBase") then
				desc.Value = false
			end
			
			if targetPower then
				if desc:GetAttribute("Eng_PowerMult") ~= nil then
					desc:SetAttribute("Eng_PowerMult", targetPower)
				end
				if desc.Name == "Eng_PowerMult" and desc:IsA("ValueBase") then
					desc.Value = targetPower
				end
			end
		end
	end)
end

local function getThrottle()
	local values = getValues()
	if values and values:FindFirstChild("Throttle") then
		return values.Throttle.Value
	end
	return 0
end

local function getGear()
	local values = getValues()
	if not values then return nil end
	local gearNames = {"Gear", "CurrentGear", "GearNum"}
	for _, name in ipairs(gearNames) do
		local obj = values:FindFirstChild(name)
		if obj then return obj.Value end
	end
	return nil
end

local function isReversing()
	if getThrottle() < -0.05 then return true end
	local gear = getGear()
	if gear then
		local g = tostring(gear):upper()
		if g == "R" or g == "REVERSE" or tonumber(gear) == -1 then return true end
	end
	return false
end

local function getSpeed(seat)
	local values = getValues()
	if values and values:FindFirstChild("Velocity") and isPoliceMap then
		local vel = values.Velocity.Value
		local dir = seat.CFrame.LookVector
		return vel:Dot(dir) * 0.9144
	end
	if seat then
		local dir = seat.CFrame.LookVector
		local vel = seat.AssemblyLinearVelocity
		return vel:Dot(dir) * 1.09728
	end
	return 0
end

