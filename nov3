-- ===== ลูปหลักควบคุมความเร็วและระบบเบื้องหลัง =====
RunService.RenderStepped:Connect(function(dt)
	local currentCar = FindNearestVehicle()
	if currentCar then
		ApplyCarModifications(currentCar)
	end

	if not enabled then
		status.Text = "ปิด"
		currentThrottle = 0
		return
	end

	local rawThrottle = getThrottle()
	if math.abs(rawThrottle) < 0.08 then
		status.Text = "รอคันเร่ง..."
		currentThrottle = 0
		return
	end

	local seat = getVehicleSeat()
	if not seat then
		status.Text = "ไม่มีพาหนะ"
		currentThrottle = 0
		return
	end

	local reversing = isReversing()
	local dir = seat.CFrame.LookVector
	local vel = seat.AssemblyLinearVelocity
	local currentSpeed = getSpeed(seat)
	local absSpeed = math.abs(currentSpeed)
	
	local target
	if reversing then
		target = 50
	else
		target = tonumber(input.Text) or 100
		if target > 2000 then target = 2000 end
	end
	if target < 0 then target = 0 end

	local moveDir = reversing and -dir or dir
	local baseResponse = raceMode and 0.18 or 0.06
	local baseMaxAdd = raceMode and 4 or 1.5
	local rampUp = raceMode and 0.10 or 0.03
	local rampDown = 0.15

	local response = baseResponse
	local maxAdd = baseMaxAdd
	if boostMode then
		response = response * 5.0
		maxAdd = maxAdd * 3.5
		rampUp = rampUp * 2.0
	end

	if reversing then
		response = response * 2.5
		maxAdd = maxAdd * 0.25
		rampUp = rampUp * 0.3
	end

	local absThrottle = math.abs(rawThrottle)
	if currentThrottle < absThrottle then
		currentThrottle = math.min(absThrottle, currentThrottle + rampUp)
	elseif currentThrottle > absThrottle then
		currentThrottle = math.max(absThrottle, currentThrottle - rampDown)
	end

	if currentThrottle > 0.08 then
		local atTarget = reversing and (absSpeed >= target) or (absSpeed >= target)
		if not atTarget then
			local diff = target - absSpeed
			local add = diff * response * currentThrottle
			add = math.min(add, maxAdd)
			seat.AssemblyLinearVelocity = vel + moveDir * add
			status.Text = math.floor(absSpeed) .. "/" .. target .. " กม/ชม" .. (reversing and " ↩" or " ➡")
		else
			local pull = (absSpeed - target) * 0.08
			seat.AssemblyLinearVelocity = vel - moveDir * pull
			status.Text = "จำกัด " .. math.floor(absSpeed) .. " กม/ชม" .. (reversing and " ↩" or " ➡")
		end
	else
		status.Text = "ว่าง " .. math.floor(absSpeed) .. " กม/ชม" .. (reversing and " ↩" or " ➡")
	end
end)
