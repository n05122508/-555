-- ===== ปุ่ม !START =====
startBtn.MouseButton1Click:Connect(function()
	local success = false
	local chatEvents = game.ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
	if chatEvents then
		local sayMsg = chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then
			sayMsg:FireServer("!START", "All")
			success = true
		end
	end
	if not success then
		pcall(function()
			local textChatService = game:GetService("TextChatService")
			local general = textChatService.TextChannels:FindFirstChild("RBXGeneral")
			if general then
				general:SendAsync("!START")
				success = true
			end
		end)
	end
	if not success then
		pcall(function()
			local remote = game.ReplicatedStorage:FindFirstChild("ChatRemote") 
				or game.ReplicatedStorage:FindFirstChild("SendMessage")
				or game.ReplicatedStorage:FindFirstChild("Chat")
			if remote and remote:IsA("RemoteEvent") then
				remote:FireServer("!START")
				success = true
			end
		end)
	end
	if success then
		startBtn.Text = "✅ ส่งแล้ว!"
		startBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 60)
		task.delay(1.2, function()
			startBtn.Text = "🏁 START (!START)"
			startBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
		end)
	else
		startBtn.Text = "❌ ไม่สำเร็จ"
		startBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
		task.delay(1.2, function()
			startBtn.Text = "🏁 START (!START)"
			startBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
		end)
	end
end)

-- ===== ลูปหลัก ถอยหลังคงที่ 50 | เดินหน้าสูงสุด 2000 =====
RunService.RenderStepped:Connect(function(dt)
	if not enabled then
		status.Text = "ปิด"
		currentThrottle = 0
		return
	end

	local rawThrottle = getThrottle()
	if math.abs(rawThrottle) < 0.08 then
		status.Text = "รอคันเร่ง..."
		currentThrottle = 0
		return
	end

	local brake = getBrake()
	local seat = getVehicle()
	if not seat then
		status.Text = "ไม่มีพาหนะ"
		currentThrottle = 0
		return
	end

	local reversing = isReversing()
	local dir = seat.CFrame.LookVector
	local vel = seat.AssemblyLinearVelocity
	local currentSpeed = getSpeed(seat)
	local absSpeed = math.abs(currentSpeed)
	
	-- ถอยหลัง = 50, เดินหน้า = ใส่เอง (สูงสุด 2000)
	local target
	if reversing then
		target = 50
	else
		target = tonumber(input.Text)
		if not target then
			status.Text = "ใส่ความเร็วก่อน"
			currentThrottle = 0
			return
		end
		if target > 2000 then target = 2000 end
	end
	if target < 0 then target = 0 end

	local moveDir = reversing and -dir or dir

	local baseResponse = raceMode and 0.18 or 0.06
	local baseMaxAdd = raceMode and 4 or 1.5
	local rampUp = raceMode and 0.10 or 0.03
	local rampDown = 0.15

	local response = baseResponse
	local maxAdd = baseMaxAdd
	if boostMode then
		response = response * 5.0
		maxAdd = maxAdd * 3.5
		rampUp = rampUp * 2.0
	end

	-- [แก้ไข] ถอยหลังช้าลงมาก
	if reversing then
		response = response * 2.5   -- อัตราเร่งเหลือ 15% (ช้ากว่า ~6-7 เท่า)
		maxAdd = maxAdd * 0.25       -- เพิ่มความเร็วต่อเฟรมน้อยลง
		rampUp = rampUp * 0.3        -- คันเร่งขึ้นช้าลง
	end

	local absThrottle = math.abs(rawThrottle)
	if currentThrottle < absThrottle then
		currentThrottle = math.min(absThrottle, currentThrottle + rampUp)
	elseif currentThrottle > absThrottle then
		currentThrottle = math.max(absThrottle, currentThrottle - rampDown)
	end

	local isBraking = (brake > 0.05) or brakeHeld

	if isBraking and absSpeed > 0.5 then
		local decelRate = 40
		local decel = decelRate * dt
		local newAbsSpeed = math.max(0, absSpeed - decel)
		if newAbsSpeed < 0.5 then newAbsSpeed = 0 end
		
		local longitudinalVel = dir * currentSpeed
		local lateralVel = vel - longitudinalVel
		seat.AssemblyLinearVelocity = (dir * (currentSpeed >= 0 and newAbsSpeed or -newAbsSpeed)) + lateralVel
		
		status.Text = "เบรก " .. math.floor(absSpeed) .. " กม/ชม"
		
	elseif currentThrottle > 0.08 then
		local atTarget = false
		if reversing then
			atTarget = currentSpeed <= -target
		else
			atTarget = currentSpeed >= target
		end
		
		if not atTarget then
			local diff = target - absSpeed
			local add = diff * response * currentThrottle
			add = math.min(add, maxAdd)
			
			seat.AssemblyLinearVelocity = vel + moveDir * add
			status.Text = math.floor(absSpeed) .. "/" .. target .. " กม/ชม" .. (reversing and " ↩" or " ➡")
		else
			local pull = (absSpeed - target) * 0.08
			seat.AssemblyLinearVelocity = vel - moveDir * pull
			status.Text = "จำกัด " .. math.floor(absSpeed) .. " กม/ชม" .. (reversing and " ↩" or " ➡")
		end
	else
		status.Text = "ว่าง " .. math.floor(absSpeed) .. " กม/ชม" .. (reversing and " ↩" or " ➡")
	end
end)
