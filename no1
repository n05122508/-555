local dragging, dragStart, startPos
frame.InputBegan:Connect(function(i)
	if locked then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = i.Position
		startPos = frame.Position
	end
end)
UIS.InputChanged:Connect(function(i)
	if not dragging or locked then return end
	if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
		local delta = i.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		hideBtn.Position = UDim2.new(frame.Position.X.Scale, frame.Position.X.Offset, frame.Position.Y.Scale, frame.Position.Y.Offset - 45)
	end
end)
UIS.InputEnded:Connect(function()
	dragging = false
end)

-- ===== ฟังก์ชันหาค่า =====
local function getValuesDrag()
	local interface = player.PlayerGui:FindFirstChild("Interface")
	return interface and interface:FindFirstChild("Values")
end

local function getValues()
	if isPoliceMap and aChassis then
		return aChassis:FindFirstChild("Values")
	else
		return getValuesDrag()
	end
end

local function getVehiclePolice()
	if not aChassis then return nil end
	local carValue = aChassis:FindFirstChild("Car")
	if carValue and carValue.Value then
		local driveSeat = carValue.Value:FindFirstChild("DriveSeat")
		if driveSeat then return driveSeat end
	end
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then return hum.SeatPart end
	end
	return nil
end

local function getVehicleDrag()
	local interface = player.PlayerGui:FindFirstChild("Interface")
	if interface then
		local bike = interface:FindFirstChild("Bike")
		if bike and bike.Value then
			local seat = bike.Value:FindFirstChild("DriveSeat")
			if seat then return seat end
		end
	end
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then return hum.SeatPart end
	end
	return nil
end

local function getVehicle()
	if isPoliceMap then
		return getVehiclePolice()
	else
		return getVehicleDrag()
	end
end

local function getThrottle()
	local values = getValues()
	if values and values:FindFirstChild("Throttle") then
		return values.Throttle.Value
	end
	return 0
end

local function getBrake()
	local values = getValues()
	if not values then return 0 end
	if isPoliceMap then
		if values:FindFirstChild("Brake") then
			return values.Brake.Value
		end
	else
		local brakeNames = {"Brake", "BrakePedal", "Braking", "IsBraking", "HandBrake", "FootBrake"}
		for _, name in ipairs(brakeNames) do
			local obj = values:FindFirstChild(name)
			if obj then return obj.Value end
		end
	end
	return 0
end

-- ===== ตรวจสอบเกีย รองรับทุกระบบ =====
local function getGear()
	local values = getValues()
	if not values then return nil end
	local gearNames = {"Gear", "CurrentGear", "GearNum", "TransmissionGear"}
	for _, name in ipairs(gearNames) do
		local obj = values:FindFirstChild(name)
		if obj then return obj.Value end
	end
	return nil
end

local function isReversing()
	local rawThrottle = getThrottle()
	
	-- เกียออโต้: Throttle ติดลบ = ถอยหลัง
	if rawThrottle < -0.05 then
		return true
	end
	
	-- เกียธรรมดา: เช็คค่า Gear เป็น R
	local gear = getGear()
	if gear then
		local g = tostring(gear):upper()
		if g == "R" or g == "REVERSE" or g == "REV" then
			return true
		end
		if tonumber(gear) == -1 then
			return true
		end
	end
	
	return false
end

local function getSpeed(seat)
	local values = getValues()
	if values then
		if isPoliceMap then
			if values:FindFirstChild("Velocity") then
				local vel = values.Velocity.Value
				local dir = seat.CFrame.LookVector
				return vel:Dot(dir) * 0.9144
			end
		else
			local speedNames = {"Speed", "KMH", "KM", "CurrentSpeed", "RealSpeed", "VehicleSpeed"}
			for _, name in ipairs(speedNames) do
				local obj = values:FindFirstChild(name)
				if obj and obj:IsA("ValueBase") then
					return obj.Value
				end
			end
		end
	end
	if seat then
		local dir = seat.CFrame.LookVector
		local vel = seat.AssemblyLinearVelocity
		return vel:Dot(dir)
	end
	return 0
end

