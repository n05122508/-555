-- ===== ลูปหลักควบคุมความเร็วรถ =====
RunService.RenderStepped:Connect(function(dt)
    if not _G.SpeedEnabled then
        currentThrottle = 0
        return
    end

    local seat = getVehicle()
    if not seat then
        currentThrottle = 0
        return
    end

    local vel = seat.AssemblyLinearVelocity
    local dir = seat.CFrame.LookVector
    local currentSpeed = vel:Dot(dir)
    local absSpeed = math.abs(currentSpeed)

    if _G.AntiFlingEnabled and math.abs(vel.Y) > 25 then
        seat.AssemblyLinearVelocity = Vector3.new(vel.X, math.clamp(vel.Y, -15, 15), vel.Z)
    end

    local rawThrottle = getThrottle()
    if math.abs(rawThrottle) < 0.08 then
        currentThrottle = 0
        return
    end

    local reversing = isReversing()
    local moveDir = reversing and -dir or dir

    local target = 0
    if reversing then
        target = 50
    else
        if _G.IsAutoGear then
            target = _G.TargetSpeed
        else
            target = _G.GearLimit or _G.TargetSpeed
        end
    end
    if target > 2000 then target = 2000 end

    local launchFactor = 1.0
    if absSpeed < 40 then
        launchFactor = 0.25
    elseif absSpeed < 80 then
        launchFactor = 0.6
    end

    local rampFactor, responseMultiplier, maxAddLimit
    if _G.SmoothMode == 1 then
        rampFactor = 0.008; responseMultiplier = 0.012; maxAddLimit = 0.4
    elseif _G.SmoothMode == 2 then
        rampFactor = 0.03; responseMultiplier = 0.04; maxAddLimit = 1.0
    else
        rampFactor = 0.2; responseMultiplier = 0.3; maxAddLimit = 5.0
    end

    local baseResponse = (_G.RaceMode and (responseMultiplier * 1.5) or responseMultiplier) * launchFactor
    local maxAdd = (_G.RaceMode and (maxAddLimit * 1.5) or maxAddLimit) * launchFactor

    if _G.BoostMode then
        baseResponse = baseResponse * 3.0
        maxAdd = maxAdd * 2.5
    end

    if reversing then
        baseResponse = baseResponse * 0.2
        maxAdd = maxAdd * 0.25
    end

    currentThrottle = math.min(math.abs(rawThrottle), currentThrottle + rampFactor)

    local isBraking = (getBrake() > 0.05) or _G.BrakeHeld
    if isBraking and absSpeed > 0.5 then
        local decel = 45 * dt
        local newSpeed = math.max(0, absSpeed - decel)
        seat.AssemblyLinearVelocity = (dir * (currentSpeed >= 0 and newSpeed or -newSpeed))
    elseif currentThrottle > 0.08 then
        if absSpeed < target then
            local add = math.min((target - absSpeed) * baseResponse * currentThrottle, maxAdd)
            seat.AssemblyLinearVelocity = vel + moveDir * add
        end
    end
end)

