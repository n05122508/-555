-- ===== 1. ฟังก์ชันวาร์ปไปหน้าร้าน + บันทึกจุดเดิม =====
local function teleportToShop()
    pcall(function()
        local character = player.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if humanoidRootPart then
            savedPositionCFrame = humanoidRootPart.CFrame
            humanoidRootPart.CFrame = shopCFrame + Vector3.new(0, 3, 0)
            task.wait(0.15)
            
            for _, prompt in ipairs(Workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    local part = prompt.Parent
                    if part and part:IsA("BasePart") then
                        if (part.Position - humanoidRootPart.Position).Magnitude < 15 then
                            fireproximityprompt(prompt)
                            break
                        end
                    end
                end
            end
            
            Rayfield:Notify({
                Title = "วาร์ปสำเร็จ!",
                Content = "มาถึงหน้าร้านอะไหล่แล้ว (บันทึกจุดเดิมเรียบร้อย)",
                Duration = 2.5
            })
        end
    end)
end

-- ===== 2. ฟังก์ชันวาร์ปกลับจุดเดิมที่เคยยืน =====
local function teleportBack()
    pcall(function()
        local character = player.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if humanoidRootPart and savedPositionCFrame then
            humanoidRootPart.CFrame = savedPositionCFrame
            Rayfield:Notify({
