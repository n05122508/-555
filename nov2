                Content = "คุณยังไม่ได้กดวาร์ปไปหน้าร้านเพื่อบันทึกจุด",
                Duration = 2.5
            })
        end
    end)
end

-- ===== ฟังก์ชันเช็กจำนวนอะไหล่ในตัว =====
local function getOwnedCount(displayName)
    local countStr = "ไม่พบข้อมูล"
    pcall(function()
        local partsGui = player.PlayerGui:FindFirstChild("PartsShop", true)
        if partsGui then
            for _, v in ipairs(partsGui:GetDescendants()) do
                if v:IsA("TextLabel") and string.find(v.Text, "มีในตัว") then
                    local parentText = v.Parent and v.Parent:FindFirstChildOfClass("TextLabel") and v.Parent:FindFirstChildOfClass("TextLabel").Text or ""
                    if string.find(parentText, displayName) or (v.Parent and string.find(v.Parent.Name, displayName)) then
                        countStr = v.Text
                        break
                    end
                end
            end
        end
    end)
    return countStr
end

-- ===== ฟังก์ชันส่งข้อความแชท =====
local function sendChatMessage(msg)
    pcall(function()
        local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
            chatEvents.SayMessageRequest:FireServer(msg, "All")
        else
            local textChatService = game:GetService("TextChatService")
            if textChatService and textChatService.TextChannels:FindFirstChild("RBXGeneral") then
                textChatService.TextChannels.RBXGeneral:SendAsync(msg)
            end
        end
    end)
end

-- ===== ฟังก์ชันดึงค่ารถ =====
local function getValues()
    if isPoliceMap and aChassis then
        return aChassis:FindFirstChild("Values")
    else
        local interface = player.PlayerGui:FindFirstChild("Interface")
        return interface and interface:FindFirstChild("Values")
    end
end

local function getVehicle()
    if isPoliceMap and aChassis then
        local carVal = aChassis:FindFirstChild("Car")
        if carVal and carVal.Value and carVal.Value:FindFirstChild("DriveSeat") then
            return carVal.Value.DriveSeat
        end
    end
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart then return hum.SeatPart end
    end
    return nil
end

local function getThrottle()
    local values = getValues()
    if values and values:FindFirstChild("Throttle") then
        return values.Throttle.Value
    end
    return 0
end

local function getBrake()
    local values = getValues()
    if not values then return 0 end
    local brakeNames = {"Brake", "BrakePedal", "Braking", "HandBrake"}
    for _, name in ipairs(brakeNames) do
        local obj = values:FindFirstChild(name)
        if obj then return obj.Value end
    end
    return 0
end

local function isReversing()
    local rawThrottle = getThrottle()
    if rawThrottle < -0.05 then return true end
    local values = getValues()
    if values and values:FindFirstChild("Gear") then
        local g = tostring(values.Gear.Value):upper()
        if g == "R" or g == "REVERSE" or tonumber(g) == -1 then return true end
    end
    return false
end

-- ===== ฟังก์ชันยิง Remote ซื้ออะไหล่ตรงรุ่น =====
local function buyPart(partName, displayName)
    pcall(function()
        local args = { partName }
        local shopRemote = ReplicatedStorage:FindFirstChild("PartsShop_Buy", true)
        
        if shopRemote then
            if shopRemote:IsA("RemoteFunction") then
                shopRemote:InvokeServer(unpack(args))
            elseif shopRemote:IsA("RemoteEvent") then
                shopRemote:FireServer(unpack(args))
            end

            task.wait(0.2)
            local currentOwned = getOwnedCount(displayName)

            Rayfield:Notify({
                Title = "สั่งซื้อสำเร็จ!",
                Content = "ซื้อ " .. (displayName or partName) .. " แล้ว (" .. currentOwned .. ")",
                Duration = 2.5
            })
        else
            Rayfield:Notify({
                Title = "ไม่พบ Remote",
                Content = "หา PartsShop_Buy ใน ReplicatedStorage ไม่พบ",
                Duration = 3
            })
        end
    end)
end

